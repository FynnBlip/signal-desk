# MiniMax API 凭据（复制本文件为 .env 后填写；.env 已被 gitignore 排除，key 永不上传）
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id

# audiobox checkpoint 路径（06 评测模块用，代码不写死路径）
# 示例：AUDIOBOX_CHECKPOINT=D:\path\to\audiobox-aesthetics\checkpoint.pt
AUDIOBOX_CHECKPOINT=your_checkpoint_path

# 07 闭环大脑的决策 LLM（DeepSeek，Anthropic 兼容接口）
# 不填时闭环用规则兜底决策，仍可跑通 demo
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
